# Environment Configuration for LinkedIn Job Scraper

# Browser Settings
# Set to 'true' in production/Render, 'false' for local visual debugging
HEADLESS=false
BROWSER=chromium
MAX_JOBS=50
DEFAULT_TIMEOUT=10000

# Google Sheets Configuration
GOOGLE_SHEET_NAME=LinkedIn Job Scraper
GOOGLE_CREDS_FILE=credentials.json
# On Render / Production, set GOOGLE_CREDENTIALS to the stringified service account JSON:
# GOOGLE_CREDENTIALS={"type": "service_account", ...}

# LinkedIn Authentication
LINKEDIN_AUTH_FILE=auth.json
# On Render / Production, set LINKEDIN_AUTH to the stringified auth.json session:
# LINKEDIN_AUTH={"cookies": [...], "origins": [...]}
